{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "prebuild": {
      "inputs": [
        "next/**",
        "tailwind/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "build": {
      "dependsOn": [
        "lint",
        "prebuild",
        "^build"
      ],
      "env": [
        "SANITY_API_TOKEN"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "dependsOn": [
        "prebuild"
      ],
      "cache": false,
      "persistent": true
    }
  }
}